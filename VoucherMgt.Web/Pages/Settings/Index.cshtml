@page
@model VoucherMgt.Web.Pages.Settings.IndexModel
@{
    ViewData["Title"] = "Company";
    ViewData["Icon"] = "bi-buildings";
}
<partial name="_Breadcrumb" />
<div class="content-panel">
    <div class="page-heading">
        <div>
            <h1>Company</h1>
            <p>Name, contact, and logo for each company that can be selected on an order form.</p>
        </div>
    </div>
    <form method="post" asp-page-handler="Vat" class="row g-3 align-items-end mb-4">
        <div class="col-md-3">
            <label class="form-label">VAT %</label>
            <input class="form-control" asp-for="DefaultVatRate" type="number" step="0.01" />
        </div>
        <div class="col-md-3"><button class="btn btn-outline-primary" type="submit">Save VAT</button></div>
    </form>
    <div class="company-board">
        @foreach (var company in Model.Companies)
        {
            <form method="post" asp-page-handler="Company" enctype="multipart/form-data" class="company-setup">
                <input type="hidden" name="CompanyId" value="@company.Id" />
                <div class="company-setup-logo">
                    @if (company.LogoFilePath is not null)
                    {
                        <img src="@Url.Page(null, "Logo", new { companyId = company.Id })" alt="" />
                    }
                    else
                    {
                        <span>@company.ShortName</span>
                    }
                </div>
                <label class="form-label">Name</label>
                <input class="form-control" name="CompanyName" value="@company.Name" required />
                <label class="form-label">Contact</label>
                <input class="form-control" name="Contact" value="@company.Contact" placeholder="Phone or email" />
                <label class="form-label">Logo</label>
                <input class="form-control" type="file" name="Logo" accept=".png,.jpg,.jpeg,.webp,image/png,image/jpeg,image/webp" />
                <button class="btn btn-primary" type="submit">Save</button>
            </form>
        }
    </div>
</div>
