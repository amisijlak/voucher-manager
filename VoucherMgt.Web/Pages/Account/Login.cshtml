@page
@model VoucherMgt.Web.Pages.Account.LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign in - Voucher Management</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <main class="min-vh-100 d-flex align-items-center justify-content-center p-4">
        <form method="post" class="card" style="max-width:440px;width:100%;">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <div class="brand-mark mx-auto mb-3">SO</div>
                    <h1 class="h4 fw-bold mb-1">Voucher Management</h1>
                    <p class="text-muted mb-0">Status One Group</p>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                {
                    <div class="alert alert-danger">@Model.ErrorMessage</div>
                }
                <div class="mb-3">
                    <label class="form-label" asp-for="Email">Email</label>
                    <input class="form-control" asp-for="Email" autocomplete="username" />
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="Password">Password</label>
                    <input class="form-control" asp-for="Password" type="password" autocomplete="current-password" />
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" asp-for="RememberMe" />
                    <label class="form-check-label" asp-for="RememberMe">Remember me</label>
                </div>
                <button class="btn btn-primary w-100" type="submit">Sign in</button>
                <p class="text-muted small mt-3 mb-0">Administrator: admin@statusone.local / Admin@123</p>
            </div>
        </form>
    </main>
</body>
</html>
