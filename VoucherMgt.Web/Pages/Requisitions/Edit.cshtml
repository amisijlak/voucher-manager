@page
@model VoucherMgt.Web.Pages.Requisitions.EditModel
@using VoucherMgt.Common
@{
    ViewData["Title"] = Model.Input.Id is null ? "New requisition" : "Edit requisition";
    ViewData["Icon"] = "bi-cash-stack";
}
<partial name="_Breadcrumb" />
<div class="content-panel">
    <div class="page-heading">
        <div>
            <h1>@ViewData["Title"]</h1>
            <p>Tracking number <strong class="tracking-number">@Model.TrackingNumber</strong>. The total is the sum of the lines, kept separate for shillings and dollars.</p>
        </div>
    </div>
    <form method="post">
        <input type="hidden" asp-for="Input.Id" />
        <div class="row g-3">
            <div class="col-md-8">
                <label class="form-label">Title</label>
                <input class="form-control" asp-for="Input.Title" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Department</label>
                <input class="form-control" asp-for="Input.Department" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Period start</label>
                <input class="form-control" asp-for="Input.PeriodStart" id="periodStart" type="date" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Period end</label>
                <input class="form-control" asp-for="Input.PeriodEnd" id="periodEnd" type="date" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Budget period</label>
                <select class="form-select" asp-for="Input.BudgetPeriodId" id="budgetPeriod">
                    <option value="">Not linked</option>
                    @foreach (var period in Model.Periods)
                    {
                        <option value="@period.Id">@period.Name</option>
                    }
                </select>
            </div>
            <div class="col-12">
                <label class="form-label">Purpose</label>
                <textarea class="form-control" asp-for="Input.Purpose" rows="2"></textarea>
            </div>
        </div>

        <p class="text-muted small mt-4 mb-2">Choose a budget period to load its lines. Leave it blank to type each item yourself.</p>
        <div class="table-responsive">
            <table class="table table-striped" id="lineTable">
                <thead>
                    <tr>
                        <th class="text-end" style="width:48px">#</th>
                        <th>Item</th>
                        <th class="text-end" style="width:110px">Qty</th>
                        <th class="text-end" style="width:170px">Unit amount</th>
                        <th style="width:110px">Currency</th>
                        <th style="width:56px"></th>
                    </tr>
                </thead>
                <tbody>
                @for (var i = 0; i < Model.Input.Lines.Count; i++)
                {
                    <tr>
                        <td class="line-no">@(i + 1)</td>
                        <td><input class="form-control" name="Input.Lines[@i].Description" value="@Model.Input.Lines[i].Description" /></td>
                        <td><input class="form-control text-end" name="Input.Lines[@i].Quantity" value="@Model.Input.Lines[i].Quantity" type="number" min="0" step="0.01" /></td>
                        <td><input class="form-control text-end amount-input" name="Input.Lines[@i].UnitAmount" value="@Money.FormatNumber(Model.Input.Lines[i].UnitAmount, Model.Input.Lines[i].Currency)" inputmode="decimal" /></td>
                        <td>
                            <select class="form-select" name="Input.Lines[@i].Currency">
                                <option value="UGX" selected="@(Model.Input.Lines[i].Currency != Money.Usd ? "selected" : null)">UGX</option>
                                <option value="USD" selected="@(Model.Input.Lines[i].Currency == Money.Usd ? "selected" : null)">USD</option>
                            </select>
                        </td>
                        <td class="text-end">
                            <input type="hidden" name="Input.Lines[@i].BudgetLineId" value="@Model.Input.Lines[i].BudgetLineId" />
                            <button class="btn btn-danger btn-sm" type="button" onclick="removeRequisitionLine(this)" title="Remove item"><i class="bi bi-trash"></i></button>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <button class="btn btn-outline-primary" type="button" onclick="addRequisitionLine()">Add item</button>
        <div class="mt-4 d-flex gap-2">
            <button class="btn btn-primary" type="submit">Save requisition</button>
            <a class="btn btn-outline-primary" asp-page="Index">Cancel</a>
        </div>
    </form>
</div>
@section Scripts {
<script>
    window.requisitionBudgetCatalog = {
        periods: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Periods.Select(p => new { id = p.Id, start = p.StartsOn.ToString("yyyy-MM-dd"), end = p.EndsOn.ToString("yyyy-MM-dd") }), new System.Text.Json.JsonSerializerOptions { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.Default })),
        lines: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BudgetLines.OrderBy(l => l.LineNumber).Select(l => new { id = l.Id, periodId = l.BudgetPeriodId, description = l.Description, amount = l.Amount, currency = l.Currency }), new System.Text.Json.JsonSerializerOptions { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.Default }))
    };
    initRequisitionItems();
</script>
}
