@page
@model VoucherMgt.Web.Pages.Orders.PrintModel
@using VoucherMgt.Common
@{
    Layout = null;
    var order = Model.Item!;
    var agreement = order.Direction == OrderDirection.Purchase
        ? "Please supply the following goods / services to"
        : "I/We hereby agree to do business with";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@order.Number</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body { background: #fff; color: #1c2430; font-family: "Times New Roman", Times, serif; }
        .sheet { max-width: 900px; margin: 24px auto; padding: 28px; border: 1px solid #c5ccd6; }
        .companies { display: flex; justify-content: space-between; gap: 12px; text-align: center; font-weight: 700; letter-spacing: .04em; }
        .companies span { flex: 1; border-bottom: 2px solid #1b3a4b; padding-bottom: 6px; }
        h1 { text-align: center; letter-spacing: .18em; font-size: 1.6rem; margin: 18px 0; }
        .field { display: flex; gap: 8px; margin-bottom: 6px; }
        .field b { min-width: 130px; }
        .field span { flex: 1; border-bottom: 1px dotted #667; }
        table { width: 100%; border-collapse: collapse; margin-top: 12px; }
        th, td { border: 1px solid #1c2430; padding: 6px 8px; vertical-align: top; }
        th { font-size: .85rem; }
        .checks { display: flex; gap: 18px; margin: 10px 0 14px; flex-wrap: wrap; }
        .box { display: inline-block; width: 14px; height: 14px; border: 1px solid #111; text-align: center; line-height: 12px; margin-right: 6px; }
        .sign { display: flex; gap: 24px; margin-top: 28px; }
        .sign div { flex: 1; }
        .line { border-bottom: 1px solid #111; height: 28px; }
        .copies, .official { border: 1px solid #111; padding: 8px 12px; margin-top: 18px; }
        .official { float: right; width: 280px; }
        @@media print { .sheet { border: 0; margin: 0; } .no-print { display: none; } }
    </style>
</head>
<body>
    <div class="sheet">
        <div class="no-print mb-3"><button onclick="window.print()">Print</button></div>
        <div class="companies">
            @foreach (var company in Model.Companies)
            {
                <span>@company.ShortName.ToUpperInvariant()</span>
            }
        </div>
        <div class="text-center small mt-1">@string.Join("  |  ", Model.Companies.Select(c => c.Name))</div>
        <h1>ORDER FORM</h1>
        <div class="text-end mb-2"><strong>No.</strong> @order.Number</div>
        <div class="field"><b>Client name</b><span>@order.PartyName</span></div>
        <div class="field"><b>Contact name</b><span>@order.ContactName</span></div>
        <div class="field"><b>Invoice name</b><span>@order.InvoiceName</span></div>
        <div class="field"><b>Address</b><span>@order.Address</span><b style="min-width:90px">City / town</b><span>@order.CityTown</span><b style="min-width:70px">Country</b><span>@order.Country</span></div>
        <div class="field"><b>Phone</b><span>@order.Phone</span><b style="min-width:50px">Fax</b><span>@order.Fax</span></div>
        <div class="field"><b>E-mail address</b><span>@order.Email</span></div>
        <p class="mt-3 mb-1">@agreement:</p>
        <div class="checks">
            @foreach (var company in Model.Companies)
            {
                <div><span class="box">@(company.Id == order.TradingCompanyId ? "✓" : "")</span>@company.Name</div>
            }
        </div>
        @if (order.Kind == OrderKind.Advertising && !string.IsNullOrWhiteSpace(order.Channel))
        {
            <p>Station / channel: <strong>@order.Channel</strong></p>
        }
        <table>
            <thead>
                <tr>
                    @if (order.Kind == OrderKind.Advertising)
                    {
                        <th>Time / programme</th>
                        <th>Length (seconds)</th>
                        <th>No. of insertions</th>
                        <th>Rate</th>
                        <th>Amount</th>
                    }
                    else
                    {
                        <th>Quantity</th>
                        <th>Description</th>
                        <th>Unit price</th>
                        <th>Amount</th>
                    }
                </tr>
            </thead>
            <tbody>
            @foreach (var line in order.Lines.OrderBy(l => l.LineNumber))
            {
                <tr>
                    @if (order.Kind == OrderKind.Advertising)
                    {
                        <td>@(line.Programme ?? line.Description)</td>
                        <td>@line.LengthSeconds</td>
                        <td>@(line.Insertions ?? (int)line.Quantity)</td>
                        <td>@Money.Format(line.UnitPrice, line.Currency)</td>
                        <td>@Money.Format(line.Amount, line.Currency)</td>
                    }
                    else
                    {
                        <td>@line.Quantity.ToString("0.##")</td>
                        <td>@line.Description</td>
                        <td>@Money.Format(line.UnitPrice, line.Currency)</td>
                        <td>@Money.Format(line.Amount, line.Currency)</td>
                    }
                </tr>
            }
            @for (var i = order.Lines.Count; i < 6; i++)
            {
                <tr><td>&nbsp;</td><td></td><td></td><td></td>@if (order.Kind == OrderKind.Advertising) { <td></td> }</tr>
            }
            </tbody>
        </table>
        <table class="mt-0" style="width:320px;margin-left:auto;">
            <tr><th>Net total</th><td>@Money.FormatPair(order.NetUgx, order.NetUsd)</td></tr>
            <tr><th>VAT @order.VatRate.ToString("0.##")%</th><td>@Money.FormatPair(order.VatUgx, order.VatUsd)</td></tr>
            <tr><th>Gross total</th><td><strong>@Money.FormatPair(order.GrossUgx, order.GrossUsd)</strong></td></tr>
        </table>
        <p class="mt-3">@order.PaymentNote</p>
        <div class="sign">
            <div>
                <div>Business manager</div>
                <div class="line">@order.BusinessManager</div>
                <div class="mt-3">Business supervisor</div>
                <div class="line">@order.BusinessSupervisor</div>
            </div>
            <div>
                <div>Client's signature</div>
                <div class="line"></div>
                <div class="mt-2">Name in full: @order.ClientSignatoryName</div>
                <div>Designation: @order.ClientDesignation</div>
                <div>Date: @(order.ClientSignedOn?.ToString("dd MMM yyyy"))</div>
            </div>
        </div>
        <div class="official">
            <strong>For official use only</strong>
            <div>Account no: @order.AccountNumber</div>
            <div>Credit control: @order.CreditControl</div>
        </div>
        <div class="copies" style="width:320px;">
            <div>Client's copy (white)</div>
            <div>Credit control section (yellow)</div>
            <div>Company copy (blue)</div>
        </div>
        <div style="clear:both"></div>
        <p class="small mt-4 mb-0">Acceptance of this order confirms the quantities, prices, and VAT treatment stated above. Cancellations must be in writing.</p>
    </div>
</body>
</html>
