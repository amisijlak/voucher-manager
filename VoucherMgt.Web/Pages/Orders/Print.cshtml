@page
@model VoucherMgt.Web.Pages.Orders.PrintModel
@using VoucherMgt.Common
@{
    Layout = null;
    var order = Model.Item!;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@order.Number</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body { background: #fff; color: #1c2430; font-family: "Times New Roman", Times, serif; }
        .sheet { max-width: 900px; margin: 24px auto; padding: 28px; border: 1px solid #c5ccd6; }
        .companies { display: flex; align-items: stretch; gap: 0; }
        .company { flex: 1; text-align: center; padding: 8px 14px 4px; position: relative; }
        .company:not(:last-child)::after { content: ""; position: absolute; top: 16px; bottom: 10px; right: 0; width: 1px; background: #c4a35a; }
        .company img { max-height: 74px; max-width: 170px; object-fit: contain; }
        .mark { height: 80px; display: flex; align-items: center; justify-content: center; font-weight: 700; letter-spacing: .06em; font-size: .75rem; }
        .company strong { display: block; margin-top: 6px; font-size: .78rem; letter-spacing: .08em; text-transform: uppercase; }
        .company strong::before { content: ""; display: block; width: 32px; height: 2px; margin: 0 auto 8px; background: #c4a35a; }
        .company em { display: block; margin-top: 4px; font-style: normal; font-size: .8rem; color: #3c4043; }
        h1 { text-align: center; letter-spacing: .28em; font-size: 1.45rem; margin: 16px 0 18px; text-transform: uppercase; }
        .field { display: flex; gap: 8px; margin-bottom: 6px; }
        .field b { min-width: 130px; }
        .field span { flex: 1; border-bottom: 1px dotted #667; }
        table { width: 100%; border-collapse: collapse; margin-top: 12px; }
        th, td { border: 1px solid #1c2430; padding: 6px 8px; vertical-align: top; }
        th { font-size: .85rem; }
        .checks { display: flex; gap: 18px; margin: 10px 0 14px; flex-wrap: wrap; }
        .box { display: inline-block; width: 14px; height: 14px; border: 1px solid #111; text-align: center; line-height: 12px; margin-right: 6px; }
        .sign { display: flex; gap: 24px; margin-top: 28px; }
        .sign div { flex: 1; }
        .line { border-bottom: 1px solid #111; height: 28px; }
        .agree { margin: 14px 0 4px; }
        .agree span { margin-left: 14px; font-style: italic; font-weight: 700; color: #6b4a12; }
        @@media print { .sheet { border: 0; margin: 0; } .no-print { display: none; } }
    </style>
</head>
<body>
    <div class="sheet">
        <div class="no-print mb-3"><button onclick="window.print()">Print</button></div>
        <div class="companies">
            @foreach (var company in Model.Companies)
            {
                <div class="company">
                    <div class="mark">
                        @if (company.LogoFilePath is not null)
                        {
                            <img src="@Url.Page(null, "Logo", new { companyId = company.Id })" alt="" />
                        }
                        else
                        {
                            <span>@company.ShortName</span>
                        }
                    </div>
                    <strong>@company.Name</strong>
                    @if (!string.IsNullOrWhiteSpace(company.Contact))
                    {
                        <em>@company.Contact</em>
                    }
                </div>
            }
        </div>
        <h1>ORDER FORM</h1>
        <div class="text-end mb-2"><strong>No.</strong> @order.Number</div>
        <div class="field"><b>Client name</b><span>@order.PartyName</span></div>
        <div class="field"><b>Contact name</b><span>@order.ContactName</span></div>
        <div class="field"><b>Invoice name</b><span>@order.InvoiceName</span></div>
        <div class="field"><b>Address</b><span>@order.Address</span></div>
        <div class="field"><b>City / town</b><span>@order.CityTown</span><b style="min-width:80px">Country</b><span>@order.Country</span></div>
        <div class="field"><b>Phone</b><span>@order.Phone</span><b style="min-width:50px">Fax</b><span>@order.Fax</span></div>
        <div class="field"><b>Email address</b><span>@order.Email</span></div>
        <p class="agree">I/We hereby agree to do business with <span>All payments should be made to respective company accounts</span></p>
        <div class="checks">
            @foreach (var company in Model.Companies)
            {
                <div><span class="box">@(company.Id == order.TradingCompanyId ? "✓" : "")</span>@company.Name</div>
            }
        </div>
        <table>
            <thead>
                <tr>
                    <th>Quantity</th>
                    <th>Description</th>
                    <th>Unit price</th>
                    <th>Currency</th>
                    <th>Amount</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var line in order.Lines.OrderBy(l => l.LineNumber))
            {
                <tr>
                    <td>@line.Quantity.ToString("0.##")</td>
                    <td>@line.Description</td>
                    <td>@Money.FormatNumber(line.UnitPrice, line.Currency)</td>
                    <td>@line.Currency</td>
                    <td>@Money.Format(line.Amount, line.Currency)</td>
                </tr>
            }
            @for (var i = order.Lines.Count; i < 6; i++)
            {
                <tr><td>&nbsp;</td><td></td><td></td><td></td><td></td></tr>
            }
            </tbody>
        </table>
        <table class="mt-0" style="width:320px;margin-left:auto;">
            <tr><th>Net total</th><td>@Money.FormatPair(order.NetUgx, order.NetUsd)</td></tr>
            <tr><th>VAT @order.VatRate.ToString("0.##")%</th><td>@Money.FormatPair(order.VatUgx, order.VatUsd)</td></tr>
            <tr><th>Gross total</th><td><strong>@Money.FormatPair(order.GrossUgx, order.GrossUsd)</strong></td></tr>
        </table>
        <div class="sign">
            <div>
                <div>Client's signature</div>
                <div class="line"></div>
                <div class="mt-3">Name in full</div>
                <div class="line"></div>
                <div class="mt-3">Designation</div>
                <div class="line"></div>
                <div class="mt-3">Date</div>
                <div class="line"></div>
            </div>
            <div>
                <div>Business manager</div>
                <div class="line"></div>
                <div class="mt-3">Business sponsor</div>
                <div class="line"></div>
            </div>
        </div>
    </div>
</body>
</html>
