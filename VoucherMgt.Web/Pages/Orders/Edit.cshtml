@page
@model VoucherMgt.Web.Pages.Orders.EditModel
@using VoucherMgt.Common
@{
    ViewData["Title"] = Model.Input.Id is null ? "New order form" : "Edit order form";
    ViewData["Icon"] = "bi-file-earmark-ruled";
}
<partial name="_Breadcrumb" />
<div class="content-panel order-sheet">
    <div class="order-letterhead">
        <div class="order-logos">
            @foreach (var company in Model.Companies)
            {
                <div class="order-logo">
                    <div class="order-logo-mark">
                        @if (company.LogoFilePath is not null)
                        {
                            <img src="@Url.Page(null, "Logo", new { companyId = company.Id })" alt="" />
                        }
                        else
                        {
                            <span>@company.ShortName</span>
                        }
                    </div>
                    <strong>@company.Name</strong>
                    @if (!string.IsNullOrWhiteSpace(company.Contact))
                    {
                        <small>@company.Contact</small>
                    }
                </div>
            }
        </div>
        <h1 class="order-form-title">Order form</h1>
    </div>
    <form method="post" id="orderForm" data-vat="@Model.VatRate.ToString(System.Globalization.CultureInfo.InvariantCulture)">
        <input type="hidden" asp-for="Input.Id" />
        <div class="row g-3">
            <div class="col-md-3"><label class="form-label">Client name</label><input class="form-control" asp-for="Input.PartyName" /></div>
            <div class="col-md-3"><label class="form-label">Contact name</label><input class="form-control" asp-for="Input.ContactName" /></div>
            <div class="col-md-3"><label class="form-label">Invoice name</label><input class="form-control" asp-for="Input.InvoiceName" /></div>
            <div class="col-md-3"><label class="form-label">Address</label><input class="form-control" asp-for="Input.Address" /></div>
            <div class="col-md-3"><label class="form-label">City / town</label><input class="form-control" asp-for="Input.CityTown" /></div>
            <div class="col-md-3"><label class="form-label">Email address</label><input class="form-control" asp-for="Input.Email" /></div>
            <div class="col-md-2"><label class="form-label">Country</label><input class="form-control" asp-for="Input.Country" /></div>
            <div class="col-md-2"><label class="form-label">Phone</label><input class="form-control" asp-for="Input.Phone" /></div>
            <div class="col-md-2"><label class="form-label">Fax</label><input class="form-control" asp-for="Input.Fax" /></div>
        </div>
        <hr />
        <div class="company-picker" id="companyPicker">
            <div class="company-picker-head">
                <span class="form-label mb-0">I/We hereby agree to do business with (Company)</span>
                <span class="company-picker-aside">
                    <span class="company-picker-required">Required</span>
                    <span class="company-pay-note">All payments should be made to respective company accounts</span>
                </span>
            </div>
            <div class="company-picker-choices" role="group" aria-label="Company">
                @foreach (var company in Model.Companies)
                {
                    <label class="company-choice">
                        <input type="checkbox" name="Input.TradingCompanyId" value="@company.Id" @(Model.Input.TradingCompanyId == company.Id ? "checked" : null) />
                        <span>
                            <strong>@company.ShortName</strong>
                            <small>@company.Name</small>
                        </span>
                    </label>
                }
            </div>
            <p class="company-picker-error" id="companyPickerError" hidden>Select the company this order belongs to.</p>
        </div>
        <div class="table-responsive">
            <table class="table req-lines" id="orderLines">
                <thead><tr><th>Quantity</th><th>Description</th><th class="text-end">Unit price</th><th>Currency</th><th class="text-end">Amount</th><th></th></tr></thead>
                <tbody>
                @for (var i = 0; i < Model.Input.Lines.Count; i++)
                {
                    var line = Model.Input.Lines[i];
                    <tr>
                        <td><input class="form-control qty" name="Input.Lines[@i].Quantity" value="@line.Quantity" type="number" step="0.01" min="0" /></td>
                        <td><input class="form-control" name="Input.Lines[@i].Description" value="@line.Description" /></td>
                        <td><input class="form-control price text-end" name="Input.Lines[@i].UnitAmount" value="@line.UnitAmount" type="number" step="0.01" min="0" /></td>
                        <td>
                            <select class="form-select currency" name="Input.Lines[@i].Currency">
                                <option value="UGX" selected="@(line.Currency != Money.Usd ? "selected" : null)">UGX</option>
                                <option value="USD" selected="@(line.Currency == Money.Usd ? "selected" : null)">USD</option>
                            </select>
                        </td>
                        <td class="text-end amount num">@Money.Format(line.Quantity * line.UnitAmount, line.Currency)</td>
                        <td><button type="button" class="btn btn-sm btn-danger" onclick="removeOrderLine(this)" title="Remove item"><i class="bi bi-trash"></i></button></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <button class="btn btn-outline-primary" type="button" onclick="addOrderLine()">Add Item</button>
        <div class="order-totals">
            <div><span>Net total</span><strong id="netTotal"></strong></div>
            <div><span>VAT @Model.VatRate.ToString("0.##")%</span><strong id="vatTotal"></strong></div>
            <div><span>Gross total</span><strong id="grossTotal"></strong></div>
        </div>
        <div class="order-sign">
            <div>
                <h2>Client's signature</h2>
                <div class="order-sign-line"></div>
                <p>Name in full</p>
                <div class="order-sign-line"></div>
                <p>Designation</p>
                <div class="order-sign-line"></div>
                <p>Date</p>
                <div class="order-sign-line"></div>
            </div>
            <div>
                <h2>Business manager</h2>
                <div class="order-sign-line"></div>
                <p>Business sponsor</p>
                <div class="order-sign-line"></div>
            </div>
        </div>
        <p class="text-muted small mt-2 mb-0">The signature, name, designation, date, business manager, and business sponsor are filled in after the form is printed.</p>
        <div class="mt-4 d-flex gap-2">
            <button class="btn btn-primary" type="submit">Save order</button>
            <a class="btn btn-outline-primary" asp-page="Index">Cancel</a>
        </div>
    </form>
</div>
<template id="orderLineTemplate">
    <tr>
        <td><input class="form-control qty" name="Input.Lines[__i__].Quantity" value="1" type="number" step="0.01" min="0" /></td>
        <td><input class="form-control" name="Input.Lines[__i__].Description" /></td>
        <td><input class="form-control price text-end" name="Input.Lines[__i__].UnitAmount" value="0" type="number" step="0.01" min="0" /></td>
        <td><select class="form-select currency" name="Input.Lines[__i__].Currency"><option value="UGX">UGX</option><option value="USD">USD</option></select></td>
        <td class="text-end amount num"></td>
        <td><button type="button" class="btn btn-sm btn-danger" onclick="removeOrderLine(this)" title="Remove item"><i class="bi bi-trash"></i></button></td>
    </tr>
</template>
@section Scripts {
<script>
    const orderForm = document.getElementById('orderForm');
    const vatRate = Number(orderForm.dataset.vat || 0);
    function money(amount, currency) {
        const usd = currency === 'USD';
        const rounded = usd ? amount : Math.round(amount);
        const text = rounded.toLocaleString('en-US', usd ? { minimumFractionDigits: 2, maximumFractionDigits: 2 } : { maximumFractionDigits: 0 });
        return usd ? '$' + text : 'UGX ' + text;
    }
    function pair(ugx, usd) {
        if (ugx && usd) return money(ugx, 'UGX') + ' + ' + money(usd, 'USD');
        return usd ? money(usd, 'USD') : money(ugx, 'UGX');
    }
    function refreshOrder() {
        let netUgx = 0, netUsd = 0;
        document.querySelectorAll('#orderLines tbody tr').forEach(row => {
            const qty = Number(row.querySelector('.qty')?.value) || 0;
            const price = Number(row.querySelector('.price')?.value) || 0;
            const currency = row.querySelector('.currency')?.value || 'UGX';
            const amount = qty * price;
            const cell = row.querySelector('.amount');
            if (cell) cell.textContent = money(amount, currency);
            if (currency === 'USD') netUsd += amount; else netUgx += amount;
        });
        const vatUgx = netUgx * vatRate / 100;
        const vatUsd = netUsd * vatRate / 100;
        document.getElementById('netTotal').textContent = pair(netUgx, netUsd);
        document.getElementById('vatTotal').textContent = pair(vatUgx, vatUsd);
        document.getElementById('grossTotal').textContent = pair(netUgx + vatUgx, netUsd + vatUsd);
    }
    document.getElementById('orderLines').addEventListener('input', refreshOrder);
    function addOrderLine() {
        const body = document.querySelector('#orderLines tbody');
        body.insertAdjacentHTML('beforeend', document.getElementById('orderLineTemplate').innerHTML.replaceAll('__i__', body.rows.length));
        refreshOrder();
    }
    function removeOrderLine(button) {
        const body = document.querySelector('#orderLines tbody');
        if (body.rows.length === 1) return;
        button.closest('tr').remove();
        [...body.rows].forEach((row, index) => row.querySelectorAll('[name]').forEach(input => input.name = input.name.replace(/Lines\[\d+\]/, 'Lines[' + index + ']')));
        refreshOrder();
    }
    const companyPicker = document.getElementById('companyPicker');
    const companyError = document.getElementById('companyPickerError');
    function selectedCompany() {
        return companyPicker.querySelector('input[type="checkbox"]:checked');
    }
    function showCompanyError(show) {
        companyPicker.classList.toggle('is-invalid', show);
        companyError.hidden = !show;
    }
    companyPicker.addEventListener('change', (event) => {
        const box = event.target;
        if (box.type !== 'checkbox') return;
        if (box.checked) {
            companyPicker.querySelectorAll('input[type="checkbox"]').forEach(other => {
                if (other !== box) other.checked = false;
            });
        }
        showCompanyError(!selectedCompany());
    });
    orderForm.addEventListener('submit', (event) => {
        if (selectedCompany()) return;
        event.preventDefault();
        showCompanyError(true);
        companyPicker.scrollIntoView({ block: 'center' });
    });
    refreshOrder();
</script>
}
