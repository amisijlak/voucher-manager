@page
@model VoucherMgt.Web.Pages.Invoices.DetailsModel
@using VoucherMgt.Common
@{
    ViewData["Title"] = Model.Item!.Number;
    ViewData["Icon"] = "bi-receipt-cutoff";
    var item = Model.Item;
    var company = item.TradingCompany ?? item.OrderForm?.TradingCompany;
    var direction = item.Direction == InvoiceDirection.Payable ? "Supplier bill" : "Client invoice";
}
<partial name="_Breadcrumb" />
<div class="content-panel order-sheet">
    <div class="order-letterhead">
        @if (company is not null)
        {
            <div class="invoice-brand">
                <div class="order-logo-mark">
                    @if (company.LogoFilePath is not null)
                    {
                        <img src="@Url.Page(null, "Logo", new { companyId = company.Id })" alt="" />
                    }
                    else
                    {
                        <span>@company.ShortName</span>
                    }
                </div>
                <div class="invoice-brand-text">
                    <strong>@company.Name</strong>
                    @if (!string.IsNullOrWhiteSpace(company.Contact))
                    {
                        <small>@company.Contact</small>
                    }
                </div>
            </div>
        }
        <h1 class="order-form-title invoice-title-line">Invoice <span class="invoice-no">@item.Number</span> <span class="badge @StatusText.Badge(item.Status)">@item.Status</span></h1>
    </div>
    <div class="order-facts">
        <div><span>Party</span><strong>@item.PartyName</strong></div>
        <div><span>Type</span><strong>@direction</strong></div>
        <div><span>Invoice date</span><strong>@item.InvoiceDate.ToString("dd MMM yyyy")</strong></div>
        @if (item.DueOn is DateOnly due)
        {
            <div><span>Due</span><strong>@due.ToString("dd MMM yyyy")</strong></div>
        }
        @if (!string.IsNullOrWhiteSpace(item.ContactName))
        {
            <div><span>Contact</span><strong>@item.ContactName</strong></div>
        }
        @if (!string.IsNullOrWhiteSpace(item.Address))
        {
            <div><span>Address</span><strong>@item.Address</strong></div>
        }
        @if (!string.IsNullOrWhiteSpace(item.ExternalNumber))
        {
            <div><span>Their invoice no.</span><strong>@item.ExternalNumber</strong></div>
        }
        @if (item.OrderForm is not null)
        {
            <div><span>Order</span><strong><a asp-page="/Orders/Details" asp-route-id="@item.OrderFormId">@item.OrderForm.Number</a></strong></div>
        }
        @if (company is not null)
        {
            <div><span>Company</span><strong>@company.Name</strong></div>
        }
    </div>
    @if (!string.IsNullOrWhiteSpace(item.Notes))
    {
        <p class="mb-3"><strong>@item.Notes</strong></p>
    }
    <div class="table-responsive">
        <table class="table req-lines">
            <thead><tr><th>Description</th><th class="text-end">Quantity</th><th class="text-end">Unit price</th><th>Currency</th><th class="text-end">Amount</th></tr></thead>
            <tbody>
            @foreach (var line in item.Lines.OrderBy(l => l.LineNumber))
            {
                <tr>
                    <td>@line.Description</td>
                    <td class="text-end">@line.Quantity.ToString("0.##")</td>
                    <td class="text-end">@Money.FormatNumber(line.UnitPrice, line.Currency)</td>
                    <td>@line.Currency</td>
                    <td class="text-end num">@Money.Format(line.Amount, line.Currency)</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <div class="order-totals">
        <div><span>Net total</span><strong>@Money.FormatPair(item.NetUgx, item.NetUsd)</strong></div>
        <div><span>VAT @item.VatRate.ToString("0.##")%</span><strong>@Money.FormatPair(item.VatUgx, item.VatUsd)</strong></div>
        <div><span>Gross total</span><strong>@Money.FormatPair(item.GrossUgx, item.GrossUsd)</strong></div>
        @if (item.PaidUgx > 0 || item.PaidUsd > 0 || item.Status == InvoiceStatus.Paid)
        {
            <div><span>Paid</span><strong>@Money.FormatPair(item.PaidUgx, item.PaidUsd)</strong></div>
            <div><span>Balance</span><strong>@Money.FormatPair(item.GrossUgx - item.PaidUgx, item.GrossUsd - item.PaidUsd)</strong></div>
        }
    </div>
    <p class="company-pay-note mt-3 mb-0">All payments should be made to respective company accounts</p>
    <div class="mt-4 d-flex flex-wrap gap-2">
        <a class="btn btn-outline-primary" asp-page="Print" asp-route-id="@item.Id" target="_blank">Print</a>
        @if (item.Status == InvoiceStatus.Draft)
        {
            <a class="btn btn-outline-primary" asp-page="Edit" asp-route-id="@item.Id">Edit</a>
        }
        @if (Model.CanCreate && item.Status == InvoiceStatus.Draft)
        {
            <form method="post" asp-page-handler="Issue" asp-route-id="@item.Id">
                <input type="hidden" name="id" value="@item.Id" />
                <button class="btn btn-primary" type="submit">Issue invoice</button>
            </form>
        }
        @if (Model.CanApprove && item.Status == InvoiceStatus.Issued)
        {
            <form method="post" asp-page-handler="Approve" asp-route-id="@item.Id">
                <input type="hidden" name="id" value="@item.Id" />
                <button class="btn btn-primary" type="submit">Approve</button>
            </form>
        }
        @if (Model.CanApprove && item.Status is not (InvoiceStatus.Paid or InvoiceStatus.Cancelled))
        {
            <form method="post" asp-page-handler="Cancel" asp-route-id="@item.Id">
                <input type="hidden" name="id" value="@item.Id" />
                <button class="btn btn-outline-primary" type="submit">Cancel</button>
            </form>
        }
        @if (item.OrderFormId is int orderId)
        {
            <a class="btn btn-outline-primary" asp-page="/Orders/Details" asp-route-id="@orderId">Back to order</a>
        }
    </div>
    @if (Model.CanPay && item.Status is InvoiceStatus.Issued or InvoiceStatus.Approved)
    {
        <form method="post" asp-page-handler="Pay" asp-route-id="@item.Id" class="invoice-pay row g-2 align-items-end">
            <input type="hidden" name="id" value="@item.Id" />
            <div class="col-md-3"><label class="form-label">Pay UGX</label><input class="form-control" asp-for="Payment.AmountUgx" type="number" step="1" /></div>
            <div class="col-md-3"><label class="form-label">Pay USD</label><input class="form-control" asp-for="Payment.AmountUsd" type="number" step="0.01" /></div>
            <div class="col-md-3"><label class="form-label">Reference</label><input class="form-control" asp-for="Payment.Reference" /></div>
            <div class="col-md-3"><button class="btn btn-primary" type="submit">Record payment</button></div>
        </form>
    }
</div>
