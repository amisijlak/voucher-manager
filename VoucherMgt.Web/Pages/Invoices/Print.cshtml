@page
@model VoucherMgt.Web.Pages.Invoices.PrintModel
@using VoucherMgt.Common
@{
    Layout = null;
    var invoice = Model.Item!;
    var company = invoice.TradingCompany ?? invoice.OrderForm?.TradingCompany;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@invoice.Number</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body { background: #fff; color: #1c2430; font-family: "Times New Roman", Times, serif; }
        .sheet { max-width: 900px; margin: 24px auto; padding: 28px; border: 1px solid #c5ccd6; }
        .brand { display: flex; align-items: center; justify-content: center; gap: 16px; }
        .mark { height: 84px; display: flex; align-items: center; justify-content: center; }
        .mark img { max-height: 80px; max-width: 180px; object-fit: contain; }
        .brand strong { display: block; font-size: .95rem; letter-spacing: .08em; text-transform: uppercase; }
        .brand strong::before { content: ""; display: block; width: 32px; height: 2px; margin-bottom: 8px; background: #c4a35a; }
        .brand em { display: block; margin-top: 4px; font-style: normal; font-size: .85rem; color: #3c4043; }
        h1 { display: flex; justify-content: center; align-items: baseline; gap: 18px; margin: 18px 0; letter-spacing: .28em; font-size: 1.45rem; text-transform: uppercase; }
        h1 .no { letter-spacing: .04em; font-size: 1.05rem; }
        .field { display: flex; gap: 8px; margin-bottom: 6px; }
        .field b { min-width: 130px; }
        .field span { flex: 1; border-bottom: 1px dotted #667; }
        table { width: 100%; border-collapse: collapse; margin-top: 12px; }
        th, td { border: 1px solid #1c2430; padding: 6px 8px; vertical-align: top; }
        th { font-size: .85rem; }
        .pay { margin-top: 16px; font-style: italic; font-weight: 700; color: #6b4a12; text-align: center; }
        @@media print { .sheet { border: 0; margin: 0; } .no-print { display: none; } }
    </style>
</head>
<body>
    <div class="sheet">
        <div class="no-print mb-3"><button onclick="window.print()">Print</button></div>
        @if (company is not null)
        {
            <div class="brand">
                <div class="mark">
                    @if (company.LogoFilePath is not null)
                    {
                        <img src="@Url.Page(null, "Logo", new { companyId = company.Id })" alt="" />
                    }
                    else
                    {
                        <span>@company.ShortName</span>
                    }
                </div>
                <div>
                    <strong>@company.Name</strong>
                    @if (!string.IsNullOrWhiteSpace(company.Contact))
                    {
                        <em>@company.Contact</em>
                    }
                </div>
            </div>
        }
        <h1>Invoice <span class="no">@invoice.Number</span></h1>
        <div class="field"><b>Party</b><span>@invoice.PartyName</span></div>
        @if (!string.IsNullOrWhiteSpace(invoice.ContactName))
        {
            <div class="field"><b>Contact</b><span>@invoice.ContactName</span></div>
        }
        @if (!string.IsNullOrWhiteSpace(invoice.Address))
        {
            <div class="field"><b>Address</b><span>@invoice.Address</span></div>
        }
        <div class="field"><b>Invoice date</b><span>@invoice.InvoiceDate.ToString("dd MMM yyyy")</span>@if (invoice.DueOn is DateOnly due) { <b style="min-width:50px">Due</b><span>@due.ToString("dd MMM yyyy")</span> }</div>
        @if (invoice.OrderForm is not null)
        {
            <div class="field"><b>Order</b><span>@invoice.OrderForm.Number</span></div>
        }
        <table>
            <thead>
                <tr>
                    <th>Description</th>
                    <th>Quantity</th>
                    <th>Unit price</th>
                    <th>Currency</th>
                    <th>Amount</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var line in invoice.Lines.OrderBy(l => l.LineNumber))
            {
                <tr>
                    <td>@line.Description</td>
                    <td>@line.Quantity.ToString("0.##")</td>
                    <td>@Money.FormatNumber(line.UnitPrice, line.Currency)</td>
                    <td>@line.Currency</td>
                    <td>@Money.Format(line.Amount, line.Currency)</td>
                </tr>
            }
            </tbody>
        </table>
        <table style="width:320px;margin-left:auto;">
            <tr><th>Net total</th><td>@Money.FormatPair(invoice.NetUgx, invoice.NetUsd)</td></tr>
            <tr><th>VAT @invoice.VatRate.ToString("0.##")%</th><td>@Money.FormatPair(invoice.VatUgx, invoice.VatUsd)</td></tr>
            <tr><th>Gross total</th><td><strong>@Money.FormatPair(invoice.GrossUgx, invoice.GrossUsd)</strong></td></tr>
            @if (invoice.PaidUgx > 0 || invoice.PaidUsd > 0)
            {
                <tr><th>Paid</th><td>@Money.FormatPair(invoice.PaidUgx, invoice.PaidUsd)</td></tr>
                <tr><th>Balance</th><td>@Money.FormatPair(invoice.GrossUgx - invoice.PaidUgx, invoice.GrossUsd - invoice.PaidUsd)</td></tr>
            }
        </table>
        <p class="pay">All payments should be made to respective company accounts</p>
    </div>
</body>
</html>
