@page
@model VoucherMgt.Web.Pages.Invoices.EditModel
@using VoucherMgt.Common
@{
    ViewData["Title"] = Model.Input.Id is null ? "New invoice" : "Edit invoice";
    ViewData["Icon"] = "bi-receipt-cutoff";
}
<partial name="_Breadcrumb" />
<div class="content-panel">
    <form method="post">
        <input type="hidden" asp-for="Input.Id" />
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Direction</label>
                <select class="form-select" asp-for="Input.Direction">
                    <option value="@InvoiceDirection.Receivable">Receivable — we invoice the client</option>
                    <option value="@InvoiceDirection.Payable">Payable — supplier bill</option>
                </select>
            </div>
            <div class="col-md-5">
                <label class="form-label">Order form</label>
                <select class="form-select" asp-for="Input.OrderFormId">
                    <option value="">None</option>
                    @foreach (var order in Model.Orders)
                    {
                        <option value="@order.Id">@order.Number — @order.PartyName</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Company</label>
                <select class="form-select" asp-for="Input.TradingCompanyId">
                    <option value="">Select</option>
                    @foreach (var company in Model.Companies)
                    {
                        <option value="@company.Id">@company.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-6"><label class="form-label">Party name</label><input class="form-control" asp-for="Input.PartyName" /></div>
            <div class="col-md-3"><label class="form-label">Their invoice no.</label><input class="form-control" asp-for="Input.ExternalNumber" /></div>
            <div class="col-md-3"><label class="form-label">Contact</label><input class="form-control" asp-for="Input.ContactName" /></div>
            <div class="col-md-6"><label class="form-label">Address</label><input class="form-control" asp-for="Input.Address" /></div>
            <div class="col-md-3"><label class="form-label">Invoice date</label><input class="form-control" asp-for="Input.InvoiceDate" type="date" /></div>
            <div class="col-md-3"><label class="form-label">Due</label><input class="form-control" asp-for="Input.DueOn" type="date" /></div>
            <div class="col-md-3">
                <label class="form-label">VAT</label>
                <select class="form-select" asp-for="Input.VatMode">
                    <option value="@VatMode.Exclusive">Exclusive</option>
                    <option value="@VatMode.Inclusive">Inclusive</option>
                    <option value="@VatMode.Exempt">Exempt</option>
                </select>
            </div>
            <div class="col-md-2"><label class="form-label">VAT %</label><input class="form-control" asp-for="Input.VatRate" type="number" step="0.01" /></div>
        </div>
        <div class="table-responsive mt-4">
            <table class="table" id="invoiceLines">
                <thead><tr><th>Description</th><th>Qty</th><th>Unit price</th><th>Currency</th><th></th></tr></thead>
                <tbody>
                @for (var i = 0; i < Model.Input.Lines.Count; i++)
                {
                    var line = Model.Input.Lines[i];
                    <tr>
                        <td><input class="form-control" name="Input.Lines[@i].Description" value="@line.Description" /></td>
                        <td><input class="form-control" type="number" step="0.01" name="Input.Lines[@i].Quantity" value="@line.Quantity" /></td>
                        <td><input class="form-control" type="number" step="0.01" name="Input.Lines[@i].UnitAmount" value="@line.UnitAmount" /></td>
                        <td>
                            <select class="form-select" name="Input.Lines[@i].Currency">
                                <option value="UGX" selected="@(line.Currency != Money.Usd ? "selected" : null)">UGX</option>
                                <option value="USD" selected="@(line.Currency == Money.Usd ? "selected" : null)">USD</option>
                            </select>
                        </td>
                        <td><button class="btn btn-sm btn-outline-primary" type="button" onclick="removeInvoiceLine(this)">Remove</button></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <button class="btn btn-outline-primary" type="button" onclick="addInvoiceLine()">Add line</button>
        <div class="mt-3"><label class="form-label">Notes</label><textarea class="form-control" asp-for="Input.Notes" rows="2"></textarea></div>
        <button class="btn btn-primary mt-3" type="submit">Save invoice</button>
    </form>
</div>
<template id="invoiceLineTemplate">
    <tr>
        <td><input class="form-control" name="Input.Lines[__i__].Description" /></td>
        <td><input class="form-control" type="number" step="0.01" name="Input.Lines[__i__].Quantity" value="1" /></td>
        <td><input class="form-control" type="number" step="0.01" name="Input.Lines[__i__].UnitAmount" /></td>
        <td><select class="form-select" name="Input.Lines[__i__].Currency"><option value="UGX">UGX</option><option value="USD">USD</option></select></td>
        <td><button class="btn btn-sm btn-outline-primary" type="button" onclick="removeInvoiceLine(this)">Remove</button></td>
    </tr>
</template>
@section Scripts {
<script>
    function addInvoiceLine() {
        const body = document.querySelector('#invoiceLines tbody');
        body.insertAdjacentHTML('beforeend', document.getElementById('invoiceLineTemplate').innerHTML.replaceAll('__i__', body.rows.length));
    }
    function removeInvoiceLine(button) {
        const body = document.querySelector('#invoiceLines tbody');
        if (body.rows.length === 1) return;
        button.closest('tr').remove();
        [...body.rows].forEach((row, index) => row.querySelectorAll('[name]').forEach(input => input.name = input.name.replace(/Lines\[\d+\]/, 'Lines[' + index + ']')));
    }
</script>
}
