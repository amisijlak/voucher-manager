@page
@model IndexModel
@using VoucherMgt.Common
@{
    ViewData["Title"] = "Dashboard";
    ViewData["Icon"] = "bi-speedometer2";
}

<partial name="_Breadcrumb" />

<div class="content-panel">
    <div class="welcome-banner d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <h2><i class="bi bi-wallet2 me-2"></i>@Model.Organization.Name</h2>
            <p>Petty cash, approvals, accountability, order forms, and invoices in one controlled workflow.</p>
        </div>
        <a class="btn btn-light fw-bold" asp-page="/Requisitions/Index" asp-route-open="new"><i class="bi bi-plus-circle me-1"></i>New requisition</a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <a class="stat-card" asp-page="/Approvals/Index">
                <div class="stat-icon amber"><i class="bi bi-check2-square"></i></div>
                <div class="stat-info"><h3>@Model.Summary.AwaitingApproval</h3><p>Awaiting approval</p></div>
            </a>
        </div>
        <div class="col-xl-3 col-md-6">
            <a class="stat-card" asp-page="/Accountability/Index">
                <div class="stat-icon rose"><i class="bi bi-receipt"></i></div>
                <div class="stat-info"><h3>@Model.Summary.AwaitingAccountability</h3><p>Open accountability</p></div>
            </a>
        </div>
        <div class="col-xl-3 col-md-6">
            <a class="stat-card" asp-page="/Orders/Index">
                <div class="stat-icon blue"><i class="bi bi-file-earmark-ruled"></i></div>
                <div class="stat-info"><h3>@Model.Summary.OpenOrders</h3><p>Open orders</p></div>
            </a>
        </div>
        <div class="col-xl-3 col-md-6">
            <a class="stat-card" asp-page="/Invoices/Index">
                <div class="stat-icon green"><i class="bi bi-receipt-cutoff"></i></div>
                <div class="stat-info"><h3>@Model.Summary.UnpaidInvoices</h3><p>Unpaid invoices</p></div>
            </a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card h-100">
                <div class="card-header">Petty cash path</div>
                <div class="card-body">
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        @foreach (var step in new[] { "Draft", "Submitted", "Approved", "Disbursed", "Accounted", "Closed" })
                        {
                            <span class="badge bg-secondary p-2">@step</span>
                            @if (step != "Closed")
                            {
                                <i class="bi bi-arrow-right text-muted"></i>
                            }
                        }
                    </div>
                    <p class="mt-3 mb-1">Cash still to account: <strong>@Money.FormatPair(Model.Summary.UnaccountedUgx, Model.Summary.UnaccountedUsd)</strong></p>
                    <p class="mb-0 text-muted">Open requisitions: @Model.Summary.OpenRequisitions</p>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card h-100">
                <div class="card-header">Active budget</div>
                <div class="card-body">
                    @if (Model.Summary.ActiveBudgetName is null)
                    {
                        <p class="mb-0 text-muted">No budget covers today. The September provisional budget is available under Budgets.</p>
                    }
                    else
                    {
                        <p class="fw-bold mb-1">@Model.Summary.ActiveBudgetName</p>
                        <p class="mb-1">Provision @Money.Format(Model.Summary.BudgetUgx, Money.Ugx)</p>
                        <p class="mb-0">Committed @Money.Format(Model.Summary.BudgetCommittedUgx, Money.Ugx)</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-header d-flex justify-content-between">
            <span>Recent requisitions</span>
            <a asp-page="/Requisitions/Index">View all</a>
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead><tr><th>Number</th><th>Title</th><th class="text-end">Requested</th><th>Status</th></tr></thead>
                <tbody>
                @foreach (var item in Model.RecentRequisitions)
                {
                    <tr>
                        <td><a asp-page="/Requisitions/Details" asp-route-id="@item.Id">@item.Number</a></td>
                        <td>@item.Title</td>
                        <td class="num">@Money.FormatPair(item.RequestedUgx, item.RequestedUsd)</td>
                        <td><span class="badge @StatusText.Badge(item.Status)">@StatusText.Label(item.Status)</span></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
