<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\VoucherMgt.Common\VoucherMgt.Common.csproj" />
    <ProjectReference Include="..\VoucherMgt.DAL\VoucherMgt.DAL.csproj" />
    <!--
      Compile BLL sources into VoucherMgt.Web instead of referencing VoucherMgt.BLL.dll.
      Smart App Control (0x800711C7) can block VoucherMgt.BLL.dll even when Authenticode-signed.
    -->
    <Compile Include="..\VoucherMgt.BLL\**\*.cs"
             Exclude="..\VoucherMgt.BLL\obj\**;..\VoucherMgt.BLL\bin\**"
             Link="LinkedBLL\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <Target Name="RemoveBlockedVoucherMgtBllDll" AfterTargets="Build">
    <Delete Files="$(OutputPath)VoucherMgt.BLL.dll;$(OutputPath)VoucherMgt.BLL.pdb"
            TreatErrorsAsWarnings="true" />
  </Target>

</Project>
